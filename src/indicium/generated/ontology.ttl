    skos:definition "A figure, table, or other display item from a scholarly publication. Carries optional FaBiO sub-type classification (via figure_type) and provenance (source_doi). Linked from Evidence.of_figure when the evidence is grounded in a visual artefact rather than a text passage." ;
    skos:exactMatch doco:Figure ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:Script a owl:Class ;
    rdfs:label "Script" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:content_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:content_url ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:source_doi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:repository_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:script_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:source_doi ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:commit_sha ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:repository_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
