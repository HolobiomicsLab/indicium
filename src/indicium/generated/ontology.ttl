        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:language ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:ScriptType ;
            owl:onProperty indicium:script_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:purpose ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:commit_sha ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:script_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:purpose ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:repository_url ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:commit_sha ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty indicium:is_supplementary ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:content_url ],
        [ a owl:Restriction ;
