@prefix ECO: <http://purl.obolibrary.org/obo/ECO_> .
@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix asb: <https://w3id.org/asb#> .
@prefix cito: <http://purl.org/spar/cito/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix doco: <http://purl.org/spar/doco/> .
@prefix fabio: <http://purl.org/spar/fabio/> .
@prefix indicium: <https://w3id.org/indicium/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sepio: <http://purl.obolibrary.org/obo/SEPIO_> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sssom: <https://w3id.org/sssom/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/indicium.owl.ttl> a owl:Ontology ;
    rdfs:label "indicium" ;
    skos:definition "Shared claim/evidence standard — ECO/CiTO/DoCO/FaBiO/SEPIO/PROV-O + Bucur SuperPattern." .

indicium:IndiciumDocument a owl:Class ;
    rdfs:label "IndiciumDocument" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom indicium:Source ;
            owl:onProperty indicium:sources ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:claim_links ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:datasets ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:figures ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:sssom_mappings ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:SoftwareEntity ;
            owl:onProperty indicium:software_entities ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:ClaimLink ;
            owl:onProperty indicium:claim_links ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:claims ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:citation_links ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:Evidence ;
            owl:onProperty indicium:evidences ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:scripts ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:Script ;
            owl:onProperty indicium:scripts ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:Figure ;
            owl:onProperty indicium:figures ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:DataAsset ;
            owl:onProperty indicium:datasets ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:software_entities ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:SSSOMMapping ;
            owl:onProperty indicium:sssom_mappings ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:evidences ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:CitationLink ;
            owl:onProperty indicium:citation_links ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:Claim ;
            owl:onProperty indicium:claims ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:sources ] ;
    skos:definition "Top-level container for a serialisable Indicium document. Holds all entity collections; enables full round-trip JSON/YAML/RDF I/O." ;
    skos:inScheme <https://w3id.org/indicium> .

ECO:0000034 a owl:Class ;
    rdfs:label "speculation" ;
    rdfs:subClassOf indicium:EvidenceType .

ECO:0000204 a owl:Class ;
    rdfs:label "author_statement" ;
    rdfs:subClassOf indicium:EcoCodeAsbSubset ;
    skos:definition "Stated by authors but not directly quoted." .

ECO:0000213 a owl:Class ;
    rdfs:label "combinatorial_evidence" ;
    rdfs:subClassOf indicium:EcoCodeAsbSubset ;
    skos:definition "Multi-method aggregate (e.g. spectral + retention time)." .

ECO:0000251 a owl:Class ;
    rdfs:label "computational_evidence" ;
    rdfs:subClassOf indicium:EcoCodeAsbSubset ;
    skos:definition "Derived from code execution or pipeline output." .

ECO:0000305 a owl:Class ;
    rdfs:label "expert_curation" ;
    rdfs:subClassOf indicium:EcoCodeAsbSubset ;
    skos:definition "Hand-curated by a domain expert." .

ECO:0000361 a owl:Class ;
    rdfs:label "inference" ;
    rdfs:subClassOf indicium:EvidenceType .

IAO:0000311 a owl:Class ;
    rdfs:label "text" ;
    rdfs:subClassOf indicium:SourceType .

IAO:0000536 a owl:Class ;
    rdfs:label "image" ;
    rdfs:subClassOf indicium:SourceType .

cito:agreesWith a owl:Class ;
    rdfs:label "agreesWith" ;
    rdfs:subClassOf indicium:LinkType .

cito:citesForInformation a owl:Class ;
    rdfs:label "citesForInformation" ;
    rdfs:subClassOf indicium:LinkType .

cito:contradicts a owl:Class ;
    rdfs:label "contradicts" ;
    rdfs:subClassOf indicium:LinkType .

cito:corrects a owl:Class ;
    rdfs:label "corrects" ;
    rdfs:subClassOf indicium:LinkType .

cito:disagreesWith a owl:Class ;
    rdfs:label "disagreesWith" ;
    rdfs:subClassOf indicium:LinkType .

cito:disputes a owl:Class ;
    rdfs:label "disputes" ;
    rdfs:subClassOf indicium:LinkType .

cito:extends a owl:Class ;
    rdfs:label "extends" ;
    rdfs:subClassOf indicium:LinkType .

cito:qualifies a owl:Class ;
    rdfs:label "qualifies" ;
    rdfs:subClassOf indicium:LinkType .

cito:refines a owl:Class ;
    rdfs:label "refines" ;
    rdfs:subClassOf indicium:LinkType .

cito:supports a owl:Class ;
    rdfs:label "supports" ;
    rdfs:subClassOf indicium:LinkType .

cito:updates a owl:Class ;
    rdfs:label "updates" ;
    rdfs:subClassOf indicium:LinkType .

cito:usesDataFrom a owl:Class ;
    rdfs:label "usesDataFrom" ;
    rdfs:subClassOf indicium:LinkType .

cito:usesMethodIn a owl:Class ;
    rdfs:label "usesMethodIn" ;
    rdfs:subClassOf indicium:LinkType .

doco:Table a owl:Class ;
    rdfs:label "table" ;
    rdfs:subClassOf indicium:SourceType .

fabio:DataPlot a owl:Class ;
    rdfs:label "data_plot" ;
    rdfs:subClassOf indicium:FigureType .

fabio:Diagram a owl:Class ;
    rdfs:label "diagram" ;
    rdfs:subClassOf indicium:FigureType .

fabio:Figure a owl:Class ;
    rdfs:label "generic" ;
    rdfs:subClassOf indicium:FigureType .

fabio:Flowchart a owl:Class ;
    rdfs:label "flowchart" ;
    rdfs:subClassOf indicium:FigureType .

fabio:Graph a owl:Class ;
    rdfs:label "graph" ;
    rdfs:subClassOf indicium:FigureType .

fabio:Photograph a owl:Class ;
    rdfs:label "photograph" ;
    rdfs:subClassOf indicium:FigureType .

fabio:Plate a owl:Class ;
    rdfs:label "plate" ;
    rdfs:subClassOf indicium:FigureType .

fabio:Table a owl:Class ;
    rdfs:label "table" ;
    rdfs:subClassOf indicium:FigureType .

indicium:CitationLink a owl:Class ;
    rdfs:label "CitationLink" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:link_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:for_claim ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:Source ;
            owl:onProperty indicium:of_source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:link_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:of_source ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:LinkType ;
            owl:onProperty indicium:link_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:Claim ;
            owl:onProperty indicium:for_claim ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:of_source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:for_claim ] ;
    skos:definition "A typed link (CiTO) from a Source to a Claim." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:ClaimLink a owl:Class ;
    rdfs:label "ClaimLink" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:to_claim ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:link_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:Claim ;
            owl:onProperty indicium:to_claim ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:from_claim ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:link_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:Claim ;
            owl:onProperty indicium:from_claim ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:from_claim ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:to_claim ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:LinkType ;
            owl:onProperty indicium:link_type ] ;
    skos:definition "A typed semantic link between two Claims using CiTO predicates. Enables contradiction detection, argument graphs, and claim ledger navigation." ;
    skos:inScheme <https://w3id.org/indicium> .

<https://w3id.org/indicium/ClaimStatus#draft> a owl:Class ;
    rdfs:label "draft" ;
    rdfs:subClassOf indicium:ClaimStatus .

<https://w3id.org/indicium/ClaimStatus#published> a owl:Class ;
    rdfs:label "published" ;
    rdfs:subClassOf indicium:ClaimStatus .

<https://w3id.org/indicium/ClaimStatus#retracted> a owl:Class ;
    rdfs:label "retracted" ;
    rdfs:subClassOf indicium:ClaimStatus .

<https://w3id.org/indicium/ClaimStatus#superseded> a owl:Class ;
    rdfs:label "superseded" ;
    rdfs:subClassOf indicium:ClaimStatus .

<https://w3id.org/indicium/ClaimStatus#verified> a owl:Class ;
    rdfs:label "verified" ;
    rdfs:subClassOf indicium:ClaimStatus .

<https://w3id.org/indicium/ClaimType#explicit> a owl:Class ;
    rdfs:label "explicit" ;
    rdfs:subClassOf indicium:ClaimType .

<https://w3id.org/indicium/ClaimType#implicit> a owl:Class ;
    rdfs:label "implicit" ;
    rdfs:subClassOf indicium:ClaimType .

indicium:Evidence a owl:Class ;
    rdfs:label "Evidence" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:of_source ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:SourceType ;
            owl:onProperty indicium:source_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:of_dataset ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:source_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:confidence ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:quote ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:of_script ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:EvidenceType ;
            owl:onProperty indicium:evidence_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:decision_context ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:text_selector ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:quote ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:supports_claim ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:quote_exact ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:supports_claim ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:quote_location ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^[a-zA-Z_][a-zA-Z0-9_]*\\.[a-zA-Z_][a-zA-Z0-9_]*$" ] ) ] ;
            owl:onProperty indicium:decision_context ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:WorkflowCoupling ;
            owl:onProperty indicium:workflow_coupling ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:workflow_coupling ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:Source ;
            owl:onProperty indicium:of_source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:for_claim ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:workflow_coupling ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:asserted_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:of_script ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:Script ;
            owl:onProperty indicium:of_script ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:for_claim ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:fragment_selector ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:of_source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:text_selector ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty indicium:confidence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:source_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:asserted_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:asserted_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:of_figure ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:quote_location ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:of_figure ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:eco_code ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:DataAsset ;
            owl:onProperty indicium:of_dataset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:quote_exact ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:fragment_selector ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:Claim ;
            owl:onProperty indicium:supports_claim ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:confidence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:quote ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:evidence_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:quote_location ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:evidence_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:quote_exact ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:TextQuoteSelector ;
            owl:onProperty indicium:text_selector ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:Claim ;
            owl:onProperty indicium:for_claim ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:eco_code ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:EcoCodeAsbSubset ;
            owl:onProperty indicium:eco_code ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:FragmentSelector ;
            owl:onProperty indicium:fragment_selector ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:Figure ;
            owl:onProperty indicium:of_figure ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:of_dataset ] ;
    skos:definition "An evidence line linking a Claim to a Source (SEPIO EvidenceLine)." ;
    skos:exactMatch sepio:0000002 ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:SSSOMMapping a owl:Class ;
    rdfs:label "SSSOMMapping" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty indicium:predicate_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:derived_from ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:object_label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:subject_label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:subject_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty indicium:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:subject_label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:confidence ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty indicium:subject_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:object_label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:predicate_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty indicium:confidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:subject_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:object_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:subject_label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:mapping_justification ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:derived_from ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:object_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:mapping_justification ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty indicium:object_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:object_label ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:confidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:predicate_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:mapping_justification ] ;
    skos:definition "A term mapping in SSSOM form (Simple Standard for Sharing Ontological Mappings) carried by an Indicium document." ;
    skos:exactMatch sssom:Mapping ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:SoftwareEntity a owl:Class ;
    rdfs:label "SoftwareEntity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:bio_tools_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty indicium:identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:canonical_url ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:edam_topics ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:edam_operation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:canonical_url ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty indicium:edam_topics ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty indicium:edam_operation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty indicium:canonical_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:edam_operation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:bio_tools_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:bio_tools_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:identifier ] ;
    skos:definition "A software tool / package with stable identity, EDAM annotations, and optional bio.tools cross-reference. Distinct from `Script` (in-paper code artefact): SoftwareEntity is a globally identified tool (e.g. MZmine, OpenMS) that multiple papers may cite." ;
    skos:exactMatch fabio:ComputerProgram ;
    skos:inScheme <https://w3id.org/indicium> .

<https://w3id.org/indicium/SourceTaskKind#analysis> a owl:Class ;
    rdfs:label "analysis" ;
    rdfs:subClassOf indicium:SourceTaskKind ;
    skos:definition "Claim arises from a new analysis of the source's data/artefacts, beyond restating the paper." .

<https://w3id.org/indicium/SourceTaskKind#component_reconstruction> a owl:Class ;
    rdfs:label "component_reconstruction" ;
    rdfs:subClassOf indicium:SourceTaskKind ;
    skos:definition "Claim concerns partial re-implementation of a specific component/step of the source's method." .

<https://w3id.org/indicium/SourceTaskKind#extension> a owl:Class ;
    rdfs:label "extension" ;
    rdfs:subClassOf indicium:SourceTaskKind ;
    skos:definition "Claim extends the source paper's task — new data, methods, or conclusions beyond original scope." .

<https://w3id.org/indicium/SourceTaskKind#reproduction> a owl:Class ;
    rdfs:label "reproduction" ;
    rdfs:subClassOf indicium:SourceTaskKind ;
    skos:definition "Claim re-derives the source paper's finding from the same or equivalent data and method." .

<https://w3id.org/indicium/SuperPatternQualifier#activates> a owl:Class ;
    rdfs:label "activates" ;
