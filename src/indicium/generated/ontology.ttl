            owl:onProperty indicium:repository ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:DatasetType ;
            owl:onProperty indicium:dataset_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:content_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:n_samples ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:data_format ] ;
    skos:definition "A data artefact (dataset, supplementary file, or public repository deposit) from a scholarly publication. Carries content-type classification (dataset_type), file format, accession number, and hosting repository. Linked from Evidence.of_dataset when the evidence is grounded in data rather than a text passage." ;
    skos:exactMatch dcat:Dataset ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:Figure a owl:Class ;
    rdfs:label "Figure" ;
    rdfs:subClassOf [ a owl:Restriction ;
