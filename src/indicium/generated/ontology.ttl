        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:accession ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:is_supplementary ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:data_format ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:data_format ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:asset_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:asset_id ],
        [ a owl:Restriction ;
