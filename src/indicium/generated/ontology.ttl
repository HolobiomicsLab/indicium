            owl:onProperty indicium:language ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:language ] ;
    skos:definition "A code artefact (script, notebook, or pipeline) from a scholarly publication. Carries role classification (script_type), programming language, repository URL, and optional pinned commit. Linked from Evidence.of_script when the evidence is grounded in code rather than a text passage or figure." ;
    skos:exactMatch fabio:ComputerProgram ;
    skos:inScheme <https://w3id.org/indicium> .

ECO:0000033 a owl:Class ;
    rdfs:label "citation",
        "textual_quotation",
        "traceable_author_statement" ;
    rdfs:subClassOf indicium:EcoCodeAsbSubset,
        indicium:EvidenceType ;
    skos:definition "Author statement with explicit textual trace (DOI + paragraph).",
        "Verbatim quote from a paper. ASB default." .

indicium:Source a owl:Class ;
    rdfs:label "Source" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:paragraph_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:xpath_pointer ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:xpath_pointer ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:authors ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:license_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:doi ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:authors ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:doi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:xpath_pointer ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:doi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:title ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:title ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:license_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:license_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty indicium:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:paragraph_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:paragraph_id ] ;
    skos:definition "A cited source/paper with stable identity." ;
    skos:exactMatch fabio:Expression ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:SourceTaskKind a owl:Class ;
    rdfs:label "SourceTaskKind" ;
    owl:unionOf ( <https://w3id.org/indicium/SourceTaskKind#reproduction> <https://w3id.org/indicium/SourceTaskKind#analysis> <https://w3id.org/indicium/SourceTaskKind#component_reconstruction> <https://w3id.org/indicium/SourceTaskKind#extension> ) ;
    skos:definition "Provenance qualifier on a Claim describing how the claim relates to the task carried out in its source paper. Claim-level sibling of WorkflowCoupling (Suter et al. 2025) in the reproducibility-provenance family, at claim↔source-task granularity rather than evidence-line↔workflow. Canonical replacement for the ASB-emitted asbext:source_task_kind extension field." ;
    skos:inScheme <https://w3id.org/indicium> ;
    linkml:permissible_values <https://w3id.org/indicium/SourceTaskKind#analysis>,
        <https://w3id.org/indicium/SourceTaskKind#component_reconstruction>,
        <https://w3id.org/indicium/SourceTaskKind#extension>,
        <https://w3id.org/indicium/SourceTaskKind#reproduction> .

indicium:WorkflowCoupling a owl:Class ;
    rdfs:label "WorkflowCoupling" ;
    owl:unionOf ( <https://w3id.org/indicium/WorkflowCoupling#tight> <https://w3id.org/indicium/WorkflowCoupling#loose> <https://w3id.org/indicium/WorkflowCoupling#ad_hoc> <https://w3id.org/indicium/WorkflowCoupling#unknown> ) ;
    skos:definition "Reproducibility-bearing coupling of the workflow that produced an evidence line (Suter et al. 2025, DOI 10.1016/j.future.2025.107974). 'tight' = shared in-memory state, individual tasks not independently reproducible; 'loose' = file/API communication, individually reproducible." ;
    skos:inScheme <https://w3id.org/indicium> ;
    linkml:permissible_values <https://w3id.org/indicium/WorkflowCoupling#ad_hoc>,
        <https://w3id.org/indicium/WorkflowCoupling#loose>,
        <https://w3id.org/indicium/WorkflowCoupling#tight>,
        <https://w3id.org/indicium/WorkflowCoupling#unknown> .

indicium:asserted_by a owl:DatatypeProperty ;
    rdfs:label "asserted_by" ;
    skos:definition "IRI or identifier of the agent (human ORCID, pipeline run ID, etc.) that asserted this item." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:confidence a owl:DatatypeProperty ;
    rdfs:label "confidence" ;
    rdfs:range xsd:float ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:for_claim a owl:ObjectProperty ;
    rdfs:label "for_claim" ;
    rdfs:range indicium:Claim ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:fragment_selector a owl:ObjectProperty ;
    rdfs:label "fragment_selector" ;
    rdfs:range indicium:FragmentSelector ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:id a owl:DatatypeProperty ;
    rdfs:label "id" ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:link_type a owl:ObjectProperty ;
    rdfs:label "link_type" ;
    rdfs:range indicium:LinkType ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:of_source a owl:ObjectProperty ;
    rdfs:label "of_source" ;
    rdfs:range indicium:Source ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:ClaimStatus a owl:Class ;
    rdfs:label "ClaimStatus" ;
    owl:unionOf ( <https://w3id.org/indicium/ClaimStatus#draft> <https://w3id.org/indicium/ClaimStatus#verified> <https://w3id.org/indicium/ClaimStatus#published> <https://w3id.org/indicium/ClaimStatus#retracted> <https://w3id.org/indicium/ClaimStatus#superseded> ) ;
    skos:definition "Lifecycle state of a Claim." ;
    skos:inScheme <https://w3id.org/indicium> ;
    linkml:permissible_values <https://w3id.org/indicium/ClaimStatus#draft>,
        <https://w3id.org/indicium/ClaimStatus#published>,
        <https://w3id.org/indicium/ClaimStatus#retracted>,
        <https://w3id.org/indicium/ClaimStatus#superseded>,
        <https://w3id.org/indicium/ClaimStatus#verified> .

indicium:EvidenceType a owl:Class ;
    rdfs:label "EvidenceType" ;
    owl:unionOf ( ECO:0000006 ECO:0000033 ECO:0000302 ECO:0000361 ECO:0000034 ) ;
    skos:inScheme <https://w3id.org/indicium> ;
    linkml:permissible_values ECO:0000006,
        ECO:0000033,
        ECO:0000034,
        ECO:0000302,
        ECO:0000361 .

indicium:SourceType a owl:Class ;
    rdfs:label "SourceType" ;
    owl:unionOf ( IAO:0000311 doco:Figure doco:Table IAO:0000536 fabio:ComputerProgram dcat:Dataset ) ;
    skos:inScheme <https://w3id.org/indicium> ;
    linkml:permissible_values IAO:0000311,
        IAO:0000536,
        doco:Figure,
        doco:Table,
        fabio:ComputerProgram,
        dcat:Dataset .

indicium:EcoCodeAsbSubset a owl:Class ;
    rdfs:label "EcoCodeAsbSubset" ;
    owl:unionOf ( ECO:0000033 ECO:0000251 ECO:0000305 ECO:0000302 ECO:0000204 ECO:0000006 ECO:0000213 ECO:0000033 ) ;
    skos:definition "ASB-emitted subset of the Evidence Code Ontology (ECO). The full ECO is large; ASB only emits these 8 values. Downstream consumers can treat this as a closed enum for ASB-sourced Evidence records." ;
    skos:inScheme <https://w3id.org/indicium> ;
    linkml:permissible_values ECO:0000006,
        ECO:0000033,
        ECO:0000204,
        ECO:0000213,
        ECO:0000251,
        ECO:0000302,
        ECO:0000305 .

indicium:content_url a owl:DatatypeProperty ;
    rdfs:label "content_url" ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:is_supplementary a owl:DatatypeProperty ;
    rdfs:label "is_supplementary" ;
    rdfs:range xsd:boolean ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:source_doi a owl:DatatypeProperty ;
    rdfs:label "source_doi" ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:FigureType a owl:Class ;
    rdfs:label "FigureType" ;
    owl:unionOf ( fabio:DataPlot fabio:Graph fabio:Photograph fabio:Plate fabio:Diagram fabio:Flowchart fabio:Table fabio:Figure ) ;
    skos:definition "FaBiO-aligned classification of figure and display item types found in scholarly publications. Values map to FaBiO sub-classes of fabio:Figure and fabio:Table." ;
    skos:inScheme <https://w3id.org/indicium> ;
    linkml:permissible_values fabio:DataPlot,
        fabio:Diagram,
        fabio:Figure,
        fabio:Flowchart,
        fabio:Graph,
        fabio:Photograph,
        fabio:Plate,
        fabio:Table .

fabio:ComputerProgram a owl:Class ;
    rdfs:label "analysis",
        "code",
        "generic",
        "notebook",
        "utility",
        "visualization",
        "workflow" ;
    rdfs:subClassOf indicium:ScriptType,
        indicium:SourceType .

dcat:Dataset a owl:Class ;
    rdfs:label "data",
        "generic",
        "image_stack",
        "model",
        "network",
        "sequence",
        "spectral",
        "tabular" ;
    rdfs:subClassOf indicium:DatasetType,
        indicium:SourceType .

indicium:Claim a owl:Class ;
    rdfs:label "Claim" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:domain_qualifier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty indicium:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:qualifier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:astra_insight_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:super_pattern ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:SourceTaskKind ;
            owl:onProperty indicium:source_task_kind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:super_pattern ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:astra_insight_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:domain_qualifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:context ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:asserted_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:source_excerpt ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:claim_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:superseded_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty indicium:superseded_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:predicate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:source_task_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[a-z][a-z0-9_]*$" ] ) ] ) ] ;
            owl:onProperty indicium:domain_qualifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:SuperPatternQualifier ;
            owl:onProperty indicium:super_pattern ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty indicium:relation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:claim_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:source_task_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:relation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:context ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:SuperPatternQualifier ;
            owl:onProperty indicium:qualifier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty indicium:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:claim_status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:relation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty indicium:context ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:superseded_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:asserted_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:ClaimType ;
            owl:onProperty indicium:claim_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:asserted_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:astra_insight_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:qualifier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:claim_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:source_excerpt ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:source_excerpt ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty indicium:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom indicium:ClaimStatus ;
            owl:onProperty indicium:claim_status ] ;
    skos:definition "A scientific claim using the Bucur 5-slot SuperPattern." ;
    skos:exactMatch asb:Claim ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:identifier a owl:DatatypeProperty ;
    rdfs:label "identifier" ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:LinkType a owl:Class ;
    rdfs:label "LinkType" ;
    owl:unionOf ( cito:supports cito:disputes cito:qualifies cito:citesForInformation cito:contradicts cito:refines cito:extends cito:agreesWith cito:disagreesWith cito:updates cito:corrects cito:usesDataFrom cito:usesMethodIn ) ;
    skos:inScheme <https://w3id.org/indicium> ;
    linkml:permissible_values cito:agreesWith,
        cito:citesForInformation,
        cito:contradicts,
        cito:corrects,
        cito:disagreesWith,
        cito:disputes,
        cito:extends,
        cito:qualifies,
        cito:refines,
        cito:supports,
        cito:updates,
        cito:usesDataFrom,
        cito:usesMethodIn .

indicium:SuperPatternQualifier a owl:Class ;
    rdfs:label "SuperPatternQualifier" ;
    owl:unionOf ( <https://w3id.org/indicium/SuperPatternQualifier#causes> <https://w3id.org/indicium/SuperPatternQualifier#prevents> <https://w3id.org/indicium/SuperPatternQualifier#inhibits> <https://w3id.org/indicium/SuperPatternQualifier#activates> <https://w3id.org/indicium/SuperPatternQualifier#increases> <https://w3id.org/indicium/SuperPatternQualifier#decreases> <https://w3id.org/indicium/SuperPatternQualifier#correlates_with> <https://w3id.org/indicium/SuperPatternQualifier#is_associated_with> <https://w3id.org/indicium/SuperPatternQualifier#predicts> <https://w3id.org/indicium/SuperPatternQualifier#interacts_with> <https://w3id.org/indicium/SuperPatternQualifier#produces> <https://w3id.org/indicium/SuperPatternQualifier#requires> <https://w3id.org/indicium/SuperPatternQualifier#enables> <https://w3id.org/indicium/SuperPatternQualifier#treats> <https://w3id.org/indicium/SuperPatternQualifier#enhances> <https://w3id.org/indicium/SuperPatternQualifier#reduces> <https://w3id.org/indicium/SuperPatternQualifier#has_property> <https://w3id.org/indicium/SuperPatternQualifier#is_part_of> <https://w3id.org/indicium/SuperPatternQualifier#is_a> <https://w3id.org/indicium/SuperPatternQualifier#consistent_with> ) ;
    skos:definition "20-term Bucur et al. (K-CAP 2021) qualifier vocabulary." ;
    skos:inScheme <https://w3id.org/indicium> ;
    linkml:permissible_values <https://w3id.org/indicium/SuperPatternQualifier#activates>,
        <https://w3id.org/indicium/SuperPatternQualifier#causes>,
        <https://w3id.org/indicium/SuperPatternQualifier#consistent_with>,
        <https://w3id.org/indicium/SuperPatternQualifier#correlates_with>,
        <https://w3id.org/indicium/SuperPatternQualifier#decreases>,
        <https://w3id.org/indicium/SuperPatternQualifier#enables>,
        <https://w3id.org/indicium/SuperPatternQualifier#enhances>,
        <https://w3id.org/indicium/SuperPatternQualifier#has_property>,
        <https://w3id.org/indicium/SuperPatternQualifier#increases>,
        <https://w3id.org/indicium/SuperPatternQualifier#inhibits>,
        <https://w3id.org/indicium/SuperPatternQualifier#interacts_with>,
        <https://w3id.org/indicium/SuperPatternQualifier#is_a>,
        <https://w3id.org/indicium/SuperPatternQualifier#is_associated_with>,
        <https://w3id.org/indicium/SuperPatternQualifier#is_part_of>,
        <https://w3id.org/indicium/SuperPatternQualifier#predicts>,
        <https://w3id.org/indicium/SuperPatternQualifier#prevents>,
        <https://w3id.org/indicium/SuperPatternQualifier#produces>,
        <https://w3id.org/indicium/SuperPatternQualifier#reduces>,
        <https://w3id.org/indicium/SuperPatternQualifier#requires>,
        <https://w3id.org/indicium/SuperPatternQualifier#treats> .


