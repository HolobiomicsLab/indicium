            owl:onProperty indicium:n_samples ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:dataset_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:source_doi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:dataset_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:repository ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:n_samples ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:accession ],
        [ a owl:Restriction ;
