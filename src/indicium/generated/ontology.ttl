indicium:TextQuoteSelector a owl:Class ;
    rdfs:label "TextQuoteSelector" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:tqs_suffix ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:tqs_prefix ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:tqs_exact ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:tqs_suffix ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:tqs_prefix ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:tqs_prefix ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:tqs_exact ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:tqs_suffix ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:tqs_exact ] ;
    skos:definition "W3C TextQuoteSelector. Exact text + optional disambiguation context. Matches ASTRA's existing oa:TextQuoteSelector alignment." ;
    skos:exactMatch oa:TextQuoteSelector ;
    skos:inScheme <https://w3id.org/indicium> .

<https://w3id.org/indicium/WorkflowCoupling#ad_hoc> a owl:Class ;
    rdfs:label "ad_hoc" ;
    rdfs:subClassOf indicium:WorkflowCoupling ;
    skos:definition "No formal coupling structure." .

<https://w3id.org/indicium/WorkflowCoupling#loose> a owl:Class ;
    rdfs:label "loose" ;
    rdfs:subClassOf indicium:WorkflowCoupling ;
    skos:definition "File/API communication; individually reproducible." .

<https://w3id.org/indicium/WorkflowCoupling#tight> a owl:Class ;
    rdfs:label "tight" ;
    rdfs:subClassOf indicium:WorkflowCoupling ;
    skos:definition "Shared in-memory state; not independently reproducible." .

<https://w3id.org/indicium/WorkflowCoupling#unknown> a owl:Class ;
    rdfs:label "unknown" ;
    rdfs:subClassOf indicium:WorkflowCoupling ;
    skos:definition "Not characterised." .

indicium:authors a owl:DatatypeProperty ;
    rdfs:label "authors" ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:citation_links a owl:ObjectProperty ;
    rdfs:label "citation_links" ;
    rdfs:range indicium:CitationLink ;
    skos:definition "All CitationLink edges in this document." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:claim_links a owl:ObjectProperty ;
    rdfs:label "claim_links" ;
    rdfs:range indicium:ClaimLink ;
    skos:definition "All ClaimLink edges in this document." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:claims a owl:ObjectProperty ;
    rdfs:label "claims" ;
    rdfs:range indicium:Claim ;
    skos:definition "All Claim entities in this document." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:datasets a owl:ObjectProperty ;
    rdfs:label "datasets" ;
    rdfs:range indicium:DataAsset ;
    skos:definition "All DataAsset entities in this document." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:decision_context a owl:DatatypeProperty ;
    rdfs:label "decision_context" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^[a-zA-Z_][a-zA-Z0-9_]*\\.[a-zA-Z_][a-zA-Z0-9_]*$" ] ) ] ;
    skos:definition "ASTRA-style 'decision_id.option_id' tags scoping this evidence item to a specific methodological universe. Empty list = universally applicable." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:derived_from a owl:DatatypeProperty ;
    rdfs:label "derived_from" ;
    rdfs:range xsd:string ;
    skos:definition "Identifiers of source mapping(s) this was inferred from (cthoyt 2026-05-29). Modelled; not yet populated by direct lexical matches." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:edam_topics a owl:DatatypeProperty ;
    rdfs:label "edam_topics" ;
    rdfs:range xsd:anyURI ;
    skos:definition "EDAM topic IRIs (multivalued)." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:evidences a owl:ObjectProperty ;
    rdfs:label "evidences" ;
    rdfs:range indicium:Evidence ;
    skos:definition "All Evidence entities in this document." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:figures a owl:ObjectProperty ;
    rdfs:label "figures" ;
    rdfs:range indicium:Figure ;
    skos:definition "All Figure entities in this document." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:scripts a owl:ObjectProperty ;
    rdfs:label "scripts" ;
    rdfs:range indicium:Script ;
    skos:definition "All Script entities in this document." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:software_entities a owl:ObjectProperty ;
    rdfs:label "software_entities" ;
    rdfs:range indicium:SoftwareEntity ;
    skos:definition "All SoftwareEntity records in this document." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:sources a owl:ObjectProperty ;
    rdfs:label "sources" ;
    rdfs:range indicium:Source ;
    skos:definition "All Source entities in this document." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:sssom_mappings a owl:ObjectProperty ;
    rdfs:label "sssom_mappings" ;
    rdfs:range indicium:SSSOMMapping ;
    skos:definition "SSSOM term mappings carried by this document." ;
    skos:inScheme <https://w3id.org/indicium> .

doco:Figure a owl:Class ;
    rdfs:label "figure" ;
    rdfs:subClassOf indicium:SourceType .

indicium:DatasetType a owl:Class ;
    rdfs:label "DatasetType" ;
    owl:unionOf ( dcat:Dataset dcat:Dataset dcat:Dataset dcat:Dataset dcat:Dataset dcat:Dataset dcat:Dataset ) ;
    skos:definition "Content-type classification of data artefacts in scholarly publications. Values map to dcat:Dataset; the enum value conveys the domain/format category of the data." ;
    skos:inScheme <https://w3id.org/indicium> ;
    linkml:permissible_values dcat:Dataset .

indicium:FragmentSelector a owl:Class ;
    rdfs:label "FragmentSelector" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty indicium:frag_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:frag_page ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:frag_page ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty indicium:frag_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty indicium:frag_page ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty indicium:frag_value ] ;
    skos:definition "W3C FragmentSelector for PDF page location." ;
    skos:exactMatch oa:FragmentSelector ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:ScriptType a owl:Class ;
    rdfs:label "ScriptType" ;
    owl:unionOf ( fabio:ComputerProgram fabio:ComputerProgram fabio:ComputerProgram fabio:ComputerProgram fabio:ComputerProgram fabio:ComputerProgram ) ;
    skos:definition "Role-based classification of code artefacts in scholarly publications. All values map to fabio:ComputerProgram; the enum value itself conveys the functional role within the paper's methodology." ;
    skos:inScheme <https://w3id.org/indicium> ;
    linkml:permissible_values fabio:ComputerProgram .

indicium:accession a owl:DatatypeProperty ;
    rdfs:label "accession" ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:asset_id a owl:DatatypeProperty ;
    rdfs:label "asset_id" ;
    skos:inScheme <https://w3id.org/indicium> .

