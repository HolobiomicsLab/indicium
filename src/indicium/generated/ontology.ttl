    rdfs:label "object" ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:object_id a owl:DatatypeProperty ;
    rdfs:label "object_id" ;
    rdfs:range xsd:string ;
    skos:definition "SSSOM object term (CURIE/IRI)." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:object_label a owl:DatatypeProperty ;
    rdfs:label "object_label" ;
    rdfs:range xsd:string ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:of_dataset a owl:ObjectProperty ;
    rdfs:label "of_dataset" ;
    rdfs:range indicium:DataAsset ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:of_figure a owl:ObjectProperty ;
    rdfs:label "of_figure" ;
    rdfs:range indicium:Figure ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:of_script a owl:ObjectProperty ;
    rdfs:label "of_script" ;
    rdfs:range indicium:Script ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:page a owl:DatatypeProperty ;
    rdfs:label "page" ;
    rdfs:range xsd:integer ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:panel_label a owl:DatatypeProperty ;
    rdfs:label "panel_label" ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:paragraph_id a owl:DatatypeProperty ;
    rdfs:label "paragraph_id" ;
    skos:definition "Stable per-paragraph identifier within the Source (e.g. the `id` attribute of a JATS `<p>` element, or an ASB-emitted `p-<n>` synthetic id). Pairs with `Evidence.quote_location`." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:predicate a owl:DatatypeProperty ;
    rdfs:label "predicate" ;
    skos:altLabel "relation" ;
    skos:definition "Spec-required name for the CiTO/SEPIO predicate. Shares slot_uri with `relation`; ASB adapter targets this name. Either may be set; they MUST agree if both are populated (enforced by downstream adapter, not at schema level)." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:predicate_id a owl:DatatypeProperty ;
    rdfs:label "predicate_id" ;
    rdfs:range xsd:string ;
    skos:definition "SSSOM mapping predicate (e.g. skos:closeMatch)." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:purpose a owl:DatatypeProperty ;
    rdfs:label "purpose" ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:qualifier a owl:ObjectProperty ;
    rdfs:label "qualifier" ;
    rdfs:range indicium:SuperPatternQualifier ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:quote a owl:DatatypeProperty ;
    rdfs:label "quote" ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:quote_exact a owl:DatatypeProperty ;
    rdfs:label "quote_exact" ;
    skos:altLabel "quote" ;
    skos:definition "Spec-required name for the verbatim text excerpt supporting a claim. Aliases `quote`; ASB adapter targets this name. SHACL-level constraint that exactly one of {quote, quote_exact} is set is deferred to v1.7." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:quote_location a owl:DatatypeProperty ;
    rdfs:label "quote_location" ;
    rdfs:range xsd:string ;
    skos:definition "Free-form locator for the quote — paragraph id, XPath pointer, page-offset string, or W3C OA fragment IRI. Use when the structured `text_selector` / `fragment_selector` classes are overkill (e.g. the ASB adapter passes a `paragraph_id` string from its source paper)." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:relation a owl:DatatypeProperty ;
    rdfs:label "relation" ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:repository a owl:DatatypeProperty ;
    rdfs:label "repository" ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:repository_url a owl:DatatypeProperty ;
    rdfs:label "repository_url" ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:script_id a owl:DatatypeProperty ;
    rdfs:label "script_id" ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:script_type a owl:ObjectProperty ;
    rdfs:label "script_type" ;
    rdfs:range indicium:ScriptType ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:source_excerpt a owl:DatatypeProperty ;
    rdfs:label "source_excerpt" ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:source_task_kind a owl:ObjectProperty ;
    rdfs:label "source_task_kind" ;
    rdfs:range indicium:SourceTaskKind ;
    skos:definition "Provenance qualifier — how this Claim relates to the task in its source paper (reproduction / analysis / component_reconstruction / extension). Claim-level sibling of Evidence.workflow_coupling. Canonical replacement for the ASB-emitted asbext:source_task_kind extension field. Optional: producers omit it when a claim spans tasks of differing kinds." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:source_type a owl:ObjectProperty ;
    rdfs:label "source_type" ;
    rdfs:range indicium:SourceType ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:subject a owl:DatatypeProperty ;
    rdfs:label "subject" ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:subject_id a owl:DatatypeProperty ;
    rdfs:label "subject_id" ;
    rdfs:range xsd:string ;
    skos:definition "SSSOM subject (CURIE/IRI)." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:subject_label a owl:DatatypeProperty ;
    rdfs:label "subject_label" ;
    rdfs:range xsd:string ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:super_pattern a owl:ObjectProperty ;
    rdfs:label "super_pattern" ;
    rdfs:range indicium:SuperPatternQualifier ;
    skos:altLabel "qualifier" ;
    skos:definition "Spec-required name for the Bucur SuperPattern qualifier. Aliases `qualifier`; the ASB adapter targets this name. Either may be set; both must agree if both are populated." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:superseded_by a owl:DatatypeProperty ;
    rdfs:label "superseded_by" ;
    rdfs:range xsd:anyURI ;
    skos:definition "URI of the Claim that supersedes this one. Must be set when claim_status is 'superseded'. Allows external Claim IRIs for cross-document lineage." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:supports_claim a owl:ObjectProperty ;
    rdfs:label "supports_claim" ;
    rdfs:range indicium:Claim ;
    skos:altLabel "for_claim" ;
    skos:definition "Spec-required name for the SEPIO `is_evidence_for` relation. Aliases `for_claim`. ASB adapter targets this name. `sepio:0000007` is the SEPIO `is evidence for` predicate." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:text_selector a owl:ObjectProperty ;
    rdfs:label "text_selector" ;
    rdfs:range indicium:TextQuoteSelector ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:title a owl:DatatypeProperty ;
    rdfs:label "title" ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:to_claim a owl:ObjectProperty ;
    rdfs:label "to_claim" ;
    rdfs:range indicium:Claim ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:tqs_exact a owl:DatatypeProperty ;
    rdfs:label "tqs_exact" ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:tqs_prefix a owl:DatatypeProperty ;
    rdfs:label "tqs_prefix" ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:tqs_suffix a owl:DatatypeProperty ;
    rdfs:label "tqs_suffix" ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:version a owl:DatatypeProperty ;
    rdfs:label "version" ;
    skos:definition "Version string (e.g. SemVer, git tag, release name)." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:workflow_coupling a owl:ObjectProperty ;
    rdfs:label "workflow_coupling" ;
    rdfs:range indicium:WorkflowCoupling ;
    skos:definition "Reproducibility qualifier — coupling of the workflow that produced this evidence (Suter et al. 2025). Optional; set by producers that know the workflow structure." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:xpath_pointer a owl:DatatypeProperty ;
    rdfs:label "xpath_pointer" ;
    skos:definition "XPath expression locating a node within the Source's structured representation (JATS XML, TEI, HTML). Alternative to `paragraph_id` when finer granularity is needed." ;
    skos:inScheme <https://w3id.org/indicium> .

ECO:0000006 a owl:Class ;
    rdfs:label "data",
        "experimental_evidence" ;
    rdfs:subClassOf indicium:EcoCodeAsbSubset,
        indicium:EvidenceType ;
    skos:definition "Generated by wet-lab experiment described in the paper." .

ECO:0000302 a owl:Class ;
    rdfs:label "inference_from_background_knowledge",
        "knowledge" ;
    rdfs:subClassOf indicium:EcoCodeAsbSubset,
        indicium:EvidenceType ;
    skos:definition "LLM-asserted from prior knowledge (no direct paper trace)." .

indicium:ClaimType a owl:Class ;
    rdfs:label "ClaimType" ;
    owl:unionOf ( <https://w3id.org/indicium/ClaimType#explicit> <https://w3id.org/indicium/ClaimType#implicit> ) ;
    skos:inScheme <https://w3id.org/indicium> ;
    linkml:permissible_values <https://w3id.org/indicium/ClaimType#explicit>,
        <https://w3id.org/indicium/ClaimType#implicit> .

indicium:DataAsset a owl:Class ;
    rdfs:label "DataAsset" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
