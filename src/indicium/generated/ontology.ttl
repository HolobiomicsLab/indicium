    rdfs:label "commit_sha" ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:context a owl:DatatypeProperty ;
    rdfs:label "context" ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:data_format a owl:DatatypeProperty ;
    rdfs:label "data_format" ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:dataset_type a owl:ObjectProperty ;
    rdfs:label "dataset_type" ;
    rdfs:range indicium:DatasetType ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:doi a owl:DatatypeProperty ;
    rdfs:label "doi" ;
    skos:definition "DOI of this Source (paper, dataset, preprint). String form, no `doi:` prefix; canonical IRI is `https://doi.org/<value>`. Distinct from generic `identifier` so adapters can target it unambiguously." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:domain_qualifier a owl:DatatypeProperty ;
    rdfs:label "domain_qualifier" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^[a-z][a-z0-9_]*$" ] ) ] ) ] ;
    skos:definition "Open-vocabulary qualifier contributed by a DomainAdapter (indicium-adapters), e.g. 'aligned_with' or 'differentially_expressed_in'. This is NOT the closed Bucur SuperPattern — values are snake_case domain terms. A Claim must carry at least one of {qualifier, domain_qualifier} (enforced by the supplemental QualifierPresenceShape, since `qualifier` itself is no longer required at the slot level)." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:eco_code a owl:ObjectProperty ;
    rdfs:label "eco_code" ;
    rdfs:range indicium:EcoCodeAsbSubset ;
    skos:definition "ASB-subset ECO classification of this evidence line. Carries an ECO IRI via the enum's `meaning`. Coexists with `evidence_type` (broader, lifecycle-oriented): `eco_code` is the canonical ASB-emitted vocabulary, `evidence_type` remains for back-compat." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:edam_operation a owl:DatatypeProperty ;
    rdfs:label "edam_operation" ;
    rdfs:range xsd:anyURI ;
    skos:definition "EDAM operation IRI (e.g. http://edamontology.org/operation_3215)." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:evidence_type a owl:ObjectProperty ;
    rdfs:label "evidence_type" ;
    rdfs:range indicium:EvidenceType ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:figure_id a owl:DatatypeProperty ;
    rdfs:label "figure_id" ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:figure_type a owl:ObjectProperty ;
    rdfs:label "figure_type" ;
    rdfs:range indicium:FigureType ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:frag_page a owl:DatatypeProperty ;
    rdfs:label "frag_page" ;
    rdfs:range xsd:integer ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:frag_value a owl:DatatypeProperty ;
    rdfs:label "frag_value" ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:from_claim a owl:ObjectProperty ;
    rdfs:label "from_claim" ;
    rdfs:range indicium:Claim ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:language a owl:DatatypeProperty ;
    rdfs:label "language" ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:license_id a owl:DatatypeProperty ;
    rdfs:label "license_id" ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:mapping_justification a owl:DatatypeProperty ;
    rdfs:label "mapping_justification" ;
    rdfs:range xsd:string ;
    skos:definition "SEMAPV justification (e.g. semapv:LexicalMatching)." ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:media_type a owl:DatatypeProperty ;
    rdfs:label "media_type" ;
    skos:inScheme <https://w3id.org/indicium> .

indicium:n_samples a owl:DatatypeProperty ;
    rdfs:label "n_samples" ;
    rdfs:range xsd:integer ;
    skos:inScheme <https://w3id.org/indicium> .

