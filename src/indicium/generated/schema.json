{
    "$defs": {
        "CitationLink": {
            "additionalProperties": false,
            "description": "A typed link (CiTO) from a Source to a Claim.",
            "properties": {
                "for_claim": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "link_type": {
                    "$ref": "#/$defs/LinkType"
                },
                "of_source": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Source"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "title": "CitationLink",
            "type": "object"
        },
        "Claim": {
            "additionalProperties": false,
            "description": "A scientific claim using the Bucur 5-slot SuperPattern.",
            "properties": {
                "asserted_by": {
                    "description": "IRI or identifier of the agent (human ORCID, pipeline run ID, etc.) that asserted this item.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "astra_insight_ref": {
                    "description": "Reference to the originating ASTRA insight in 'analysis_id/insight_id' format.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "claim_status": {
                    "$ref": "#/$defs/ClaimStatus"
                },
                "claim_type": {
                    "$ref": "#/$defs/ClaimType"
                },
                "context": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "object": {
                    "type": "string"
                },
                "qualifier": {
                    "$ref": "#/$defs/SuperPatternQualifier"
                },
                "relation": {
                    "type": "string"
                },
                "source_excerpt": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "subject": {
                    "type": "string"
                },
                "superseded_by": {
                    "description": "URI of the Claim that supersedes this one. Must be set when claim_status is 'superseded'. Allows external Claim IRIs for cross-document lineage.",
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "id",
                "context",
                "subject",
                "qualifier",
                "relation",
                "object"
            ],
            "title": "Claim",
            "type": "object"
        },
        "ClaimLink": {
            "additionalProperties": false,
            "description": "A typed semantic link between two Claims using CiTO predicates. Enables contradiction detection, argument graphs, and claim ledger navigation.",
            "properties": {
                "from_claim": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "link_type": {
                    "$ref": "#/$defs/LinkType"
                },
                "to_claim": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "title": "ClaimLink",
            "type": "object"
        },
        "ClaimStatus": {
            "description": "Lifecycle state of a Claim.",
            "enum": [
                "draft",
                "verified",
                "published",
                "retracted",
                "superseded"
            ],
            "title": "ClaimStatus",
            "type": "string"
        },
        "ClaimType": {
            "description": "",
            "enum": [
                "explicit",
                "implicit"
            ],
            "title": "ClaimType",
            "type": "string"
        },
        "Claim__identifier_optional": {
            "additionalProperties": false,
            "description": "A scientific claim using the Bucur 5-slot SuperPattern.",
            "properties": {
                "asserted_by": {
                    "description": "IRI or identifier of the agent (human ORCID, pipeline run ID, etc.) that asserted this item.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "astra_insight_ref": {
                    "description": "Reference to the originating ASTRA insight in 'analysis_id/insight_id' format.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "claim_status": {
                    "$ref": "#/$defs/ClaimStatus"
                },
                "claim_type": {
                    "$ref": "#/$defs/ClaimType"
                },
                "context": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "object": {
                    "type": "string"
                },
                "qualifier": {
                    "$ref": "#/$defs/SuperPatternQualifier"
                },
                "relation": {
                    "type": "string"
                },
                "source_excerpt": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "subject": {
                    "type": "string"
                },
                "superseded_by": {
                    "description": "URI of the Claim that supersedes this one. Must be set when claim_status is 'superseded'. Allows external Claim IRIs for cross-document lineage.",
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "context",
                "subject",
                "qualifier",
                "relation",
                "object"
            ],
            "title": "Claim",
            "type": "object"
        },
        "DataAsset": {
            "additionalProperties": false,
            "description": "A data artefact (dataset, supplementary file, or public repository deposit) from a scholarly publication. Carries content-type classification (dataset_type), file format, accession number, and hosting repository. Linked from Evidence.of_dataset when the evidence is grounded in data rather than a text passage.",
            "properties": {
                "accession": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "asset_id": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "content_url": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "data_format": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "dataset_type": {
                    "$ref": "#/$defs/DatasetType"
                },
                "identifier": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "is_supplementary": {
                    "type": [
                        "boolean",
                        "null"
                    ]
                },
                "n_samples": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "repository": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "source_doi": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "title": "DataAsset",
            "type": "object"
        },
        "DatasetType": {
            "description": "Content-type classification of data artefacts in scholarly publications. Values map to dcat:Dataset; the enum value conveys the domain/format category of the data.",
            "enum": [
                "tabular",
                "sequence",
                "spectral",
                "image_stack",
                "network",
                "model",
                "generic"
            ],
            "title": "DatasetType",
            "type": "string"
        },
        "Evidence": {
            "additionalProperties": false,
            "description": "An evidence line linking a Claim to a Source (SEPIO EvidenceLine).",
            "properties": {
                "asserted_by": {
                    "description": "IRI or identifier of the agent (human ORCID, pipeline run ID, etc.) that asserted this item.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "confidence": {
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "decision_context": {
                    "description": "ASTRA-style 'decision_id.option_id' tags scoping this evidence item to a specific methodological universe. Empty list = universally applicable.",
                    "items": {
                        "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*\\.[a-zA-Z_][a-zA-Z0-9_]*$",
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "evidence_type": {
                    "$ref": "#/$defs/EvidenceType"
                },
                "for_claim": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "fragment_selector": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/FragmentSelector"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "of_dataset": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/DataAsset"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "of_figure": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Figure"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "of_script": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Script"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "of_source": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Source"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "quote": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "source_type": {
                    "$ref": "#/$defs/SourceType"
                },
                "text_selector": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/TextQuoteSelector"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "title": "Evidence",
            "type": "object"
        },
        "EvidenceType": {
            "description": "",
            "enum": [
                "data",
                "citation",
                "knowledge",
                "inference",
                "speculation"
            ],
            "title": "EvidenceType",
            "type": "string"
        },
        "Figure": {
            "additionalProperties": false,
            "description": "A figure, table, or other display item from a scholarly publication. Carries optional FaBiO sub-type classification (via figure_type) and provenance (source_doi). Linked from Evidence.of_figure when the evidence is grounded in a visual artefact rather than a text passage.",
            "properties": {
                "caption": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "content_url": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "figure_id": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "figure_type": {
                    "$ref": "#/$defs/FigureType"
                },
                "fragment_selector": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/FragmentSelector"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "identifier": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "is_supplementary": {
                    "type": [
                        "boolean",
                        "null"
                    ]
                },
                "media_type": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "page": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "panel_label": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "source_doi": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "title": "Figure",
            "type": "object"
        },
        "FigureType": {
            "description": "FaBiO-aligned classification of figure and display item types found in scholarly publications. Values map to FaBiO sub-classes of fabio:Figure and fabio:Table.",
            "enum": [
                "data_plot",
                "graph",
                "photograph",
                "plate",
                "diagram",
                "flowchart",
                "table",
                "generic"
            ],
            "title": "FigureType",
            "type": "string"
        },
        "FragmentSelector": {
            "additionalProperties": false,
            "description": "W3C FragmentSelector for PDF page location.",
            "properties": {
                "frag_page": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "frag_value": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "title": "FragmentSelector",
            "type": "object"
        },
        "IndiciumDocument": {
            "additionalProperties": false,
            "description": "Top-level container for a serialisable Indicium document. Holds all entity collections; enables full round-trip JSON/YAML/RDF I/O.",
            "properties": {
                "citation_links": {
                    "description": "All CitationLink edges in this document.",
                    "items": {
                        "$ref": "#/$defs/CitationLink"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "claim_links": {
                    "description": "All ClaimLink edges in this document.",
                    "items": {
                        "$ref": "#/$defs/ClaimLink"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "claims": {
                    "additionalProperties": {
                        "$ref": "#/$defs/Claim__identifier_optional"
                    },
                    "description": "All Claim entities in this document.",
                    "type": [
                        "object",
                        "null"
                    ]
                },
                "datasets": {
                    "description": "All DataAsset entities in this document.",
                    "items": {
                        "$ref": "#/$defs/DataAsset"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "evidences": {
                    "description": "All Evidence entities in this document.",
                    "items": {
                        "$ref": "#/$defs/Evidence"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "figures": {
                    "description": "All Figure entities in this document.",
                    "items": {
                        "$ref": "#/$defs/Figure"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "scripts": {
                    "description": "All Script entities in this document.",
                    "items": {
                        "$ref": "#/$defs/Script"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "sources": {
                    "description": "All Source entities in this document.",
                    "items": {
                        "$ref": "#/$defs/Source"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                }
            },
            "title": "IndiciumDocument",
            "type": "object"
        },
        "LinkType": {
            "description": "",
            "enum": [
                "supports",
                "disputes",
                "qualifies",
                "citesForInformation",
                "contradicts",
                "refines",
                "extends",
                "agreesWith",
                "disagreesWith",
                "updates",
                "corrects",
                "usesDataFrom",
                "usesMethodIn"
            ],
            "title": "LinkType",
            "type": "string"
        },
        "Script": {
            "additionalProperties": false,
            "description": "A code artefact (script, notebook, or pipeline) from a scholarly publication. Carries role classification (script_type), programming language, repository URL, and optional pinned commit. Linked from Evidence.of_script when the evidence is grounded in code rather than a text passage or figure.",
            "properties": {
                "commit_sha": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "content_url": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "identifier": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "is_supplementary": {
                    "type": [
                        "boolean",
                        "null"
                    ]
                },
                "language": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "purpose": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "repository_url": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "script_id": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "script_type": {
                    "$ref": "#/$defs/ScriptType"
                },
                "source_doi": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "title": "Script",
            "type": "object"
        },
        "ScriptType": {
            "description": "Role-based classification of code artefacts in scholarly publications. All values map to fabio:ComputerProgram; the enum value itself conveys the functional role within the paper's methodology.",
            "enum": [
                "analysis",
                "visualization",
                "workflow",
                "notebook",
                "utility",
                "generic"
            ],
            "title": "ScriptType",
            "type": "string"
        },
        "Source": {
            "additionalProperties": false,
            "description": "A cited source/paper with stable identity.",
            "properties": {
                "authors": {
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "identifier": {
                    "type": "string"
                },
                "license_id": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "title": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "identifier"
            ],
            "title": "Source",
            "type": "object"
        },
        "SourceType": {
            "description": "",
            "enum": [
                "text",
                "figure",
                "table",
                "image",
                "code",
                "data"
            ],
            "title": "SourceType",
            "type": "string"
        },
        "SuperPatternQualifier": {
            "description": "20-term Bucur et al. (K-CAP 2021) qualifier vocabulary.",
            "enum": [
                "causes",
                "prevents",
                "inhibits",
                "activates",
                "increases",
                "decreases",
                "correlates_with",
                "is_associated_with",
                "predicts",
                "interacts_with",
                "produces",
                "requires",
                "enables",
                "treats",
                "enhances",
                "reduces",
                "has_property",
                "is_part_of",
                "is_a",
                "consistent_with"
            ],
            "title": "SuperPatternQualifier",
            "type": "string"
        },
        "TextQuoteSelector": {
            "additionalProperties": false,
            "description": "W3C TextQuoteSelector. Exact text + optional disambiguation context. Matches ASTRA's existing oa:TextQuoteSelector alignment.",
            "properties": {
                "tqs_exact": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "tqs_prefix": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "tqs_suffix": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "title": "TextQuoteSelector",
            "type": "object"
        }
    },
    "$id": "https://w3id.org/indicium",
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "additionalProperties": true,
    "description": "Top-level container for a serialisable Indicium document. Holds all entity collections; enables full round-trip JSON/YAML/RDF I/O.",
    "metamodel_version": "1.11.0",
    "properties": {
        "citation_links": {
            "description": "All CitationLink edges in this document.",
            "items": {
                "$ref": "#/$defs/CitationLink"
            },
            "type": [
                "array",
                "null"
            ]
        },
        "claim_links": {
            "description": "All ClaimLink edges in this document.",
            "items": {
                "$ref": "#/$defs/ClaimLink"
            },
            "type": [
                "array",
                "null"
            ]
        },
        "claims": {
            "additionalProperties": {
                "$ref": "#/$defs/Claim__identifier_optional"
            },
            "description": "All Claim entities in this document.",
            "type": [
                "object",
                "null"
            ]
        },
        "datasets": {
            "description": "All DataAsset entities in this document.",
            "items": {
                "$ref": "#/$defs/DataAsset"
            },
            "type": [
                "array",
                "null"
            ]
        },
        "evidences": {
            "description": "All Evidence entities in this document.",
            "items": {
                "$ref": "#/$defs/Evidence"
            },
            "type": [
                "array",
                "null"
            ]
        },
        "figures": {
            "description": "All Figure entities in this document.",
            "items": {
                "$ref": "#/$defs/Figure"
            },
            "type": [
                "array",
                "null"
            ]
        },
        "scripts": {
            "description": "All Script entities in this document.",
            "items": {
                "$ref": "#/$defs/Script"
            },
            "type": [
                "array",
                "null"
            ]
        },
        "sources": {
            "description": "All Source entities in this document.",
            "items": {
                "$ref": "#/$defs/Source"
            },
            "type": [
                "array",
                "null"
            ]
        }
    },
    "title": "indicium",
    "type": "object",
    "version": null
}

