{
    "$defs": {
        "CitationLink": {
            "additionalProperties": false,
            "description": "A typed link (CiTO) from a Source to a Claim.",
            "properties": {
                "for_claim": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "link_type": {
                    "$ref": "#/$defs/LinkType"
                },
                "of_source": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Source"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "title": "CitationLink",
            "type": "object"
        },
        "Claim": {
            "additionalProperties": false,
            "description": "A scientific claim using the Bucur 5-slot SuperPattern.",
            "properties": {
                "claim_type": {
                    "$ref": "#/$defs/ClaimType"
                },
                "context": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "object": {
                    "type": "string"
                },
                "qualifier": {
                    "$ref": "#/$defs/SuperPatternQualifier"
                },
                "relation": {
                    "type": "string"
                },
                "source_excerpt": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "subject": {
                    "type": "string"
                }
            },
            "required": [
                "id",
                "context",
                "subject",
                "qualifier",
                "relation",
                "object"
            ],
            "title": "Claim",
            "type": "object"
        },
        "ClaimType": {
            "description": "",
            "enum": [
                "explicit",
                "implicit"
            ],
            "title": "ClaimType",
            "type": "string"
        },
        "DataAsset": {
            "additionalProperties": false,
            "description": "A data artefact (dataset, supplementary file, or public repository deposit) from a scholarly publication. Carries content-type classification (dataset_type), file format, accession number, and hosting repository. Linked from Evidence.of_dataset when the evidence is grounded in data rather than a text passage.",
            "properties": {
                "accession": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "asset_id": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "content_url": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "data_format": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "dataset_type": {
                    "$ref": "#/$defs/DatasetType"
                },
                "identifier": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "is_supplementary": {
                    "type": [
                        "boolean",
                        "null"
                    ]
                },
                "n_samples": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "repository": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "source_doi": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "title": "DataAsset",
            "type": "object"
        },
        "DatasetType": {
            "description": "Content-type classification of data artefacts in scholarly publications. Values map to dcat:Dataset; the enum value conveys the domain/format category of the data.",
            "enum": [
                "tabular",
                "sequence",
                "spectral",
                "image_stack",
                "network",
                "model",
                "generic"
            ],
            "title": "DatasetType",
            "type": "string"
        },
        "Evidence": {
            "additionalProperties": false,
            "description": "An evidence line linking a Claim to a Source (SEPIO EvidenceLine).",
            "properties": {
                "confidence": {
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "evidence_type": {
                    "$ref": "#/$defs/EvidenceType"
                },
                "for_claim": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "of_dataset": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/DataAsset"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "of_figure": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Figure"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "of_script": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Script"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "of_source": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Source"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "quote": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "source_type": {
                    "$ref": "#/$defs/SourceType"
                }
            },
            "title": "Evidence",
            "type": "object"
        },
        "EvidenceType": {
            "description": "",
            "enum": [
                "data",
                "citation",
                "knowledge",
                "inference",
                "speculation"
            ],
            "title": "EvidenceType",
            "type": "string"
        },
        "Figure": {
            "additionalProperties": false,
            "description": "A figure, table, or other display item from a scholarly publication. Carries optional FaBiO sub-type classification (via figure_type) and provenance (source_doi). Linked from Evidence.of_figure when the evidence is grounded in a visual artefact rather than a text passage.",
            "properties": {
                "caption": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "content_url": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "figure_id": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "figure_type": {
                    "$ref": "#/$defs/FigureType"
                },
                "identifier": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "is_supplementary": {
                    "type": [
                        "boolean",
                        "null"
                    ]
                },
                "media_type": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "page": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "panel_label": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "source_doi": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "title": "Figure",
            "type": "object"
        },
        "FigureType": {
            "description": "FaBiO-aligned classification of figure and display item types found in scholarly publications. Values map to FaBiO sub-classes of fabio:Figure and fabio:Table.",
            "enum": [
                "data_plot",
                "graph",
                "photograph",
                "plate",
                "diagram",
                "flowchart",
                "table",
                "generic"
            ],
            "title": "FigureType",
            "type": "string"
        },
        "LinkType": {
            "description": "",
            "enum": [
                "supports",
                "disputes",
                "qualifies",
                "citesForInformation"
            ],
            "title": "LinkType",
            "type": "string"
        },
        "Script": {
            "additionalProperties": false,
            "description": "A code artefact (script, notebook, or pipeline) from a scholarly publication. Carries role classification (script_type), programming language, repository URL, and optional pinned commit. Linked from Evidence.of_script when the evidence is grounded in code rather than a text passage or figure.",
            "properties": {
                "commit_sha": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "content_url": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "identifier": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "is_supplementary": {
                    "type": [
                        "boolean",
                        "null"
                    ]
                },
                "language": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "purpose": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "repository_url": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "script_id": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "script_type": {
                    "$ref": "#/$defs/ScriptType"
                },
                "source_doi": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "title": "Script",
            "type": "object"
        },
        "ScriptType": {
            "description": "Role-based classification of code artefacts in scholarly publications. All values map to fabio:ComputerProgram; the enum value itself conveys the functional role within the paper's methodology.",
            "enum": [
                "analysis",
                "visualization",
                "workflow",
                "notebook",
                "utility",
                "generic"
            ],
            "title": "ScriptType",
            "type": "string"
        },
        "Source": {
            "additionalProperties": false,
            "description": "A cited source/paper with stable identity.",
            "properties": {
                "authors": {
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "identifier": {
                    "type": "string"
                },
                "license_id": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "title": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "identifier"
            ],
            "title": "Source",
            "type": "object"
        },
        "SourceType": {
            "description": "",
            "enum": [
                "text",
                "figure",
                "table",
                "image",
                "code",
                "data"
            ],
            "title": "SourceType",
            "type": "string"
        },
        "SuperPatternQualifier": {
            "description": "20-term Bucur et al. (K-CAP 2021) qualifier vocabulary.",
            "enum": [
                "causes",
                "prevents",
                "inhibits",
                "activates",
                "increases",
                "decreases",
                "correlates_with",
                "is_associated_with",
                "predicts",
                "interacts_with",
                "produces",
                "requires",
                "enables",
                "treats",
                "enhances",
                "reduces",
                "has_property",
                "is_part_of",
                "is_a",
                "consistent_with"
            ],
            "title": "SuperPatternQualifier",
            "type": "string"
        }
    },
    "$id": "https://w3id.org/indicium",
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "additionalProperties": true,
    "metamodel_version": "1.11.0",
    "title": "indicium",
    "type": "object",
    "version": null
}

