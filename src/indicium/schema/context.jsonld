{
  "@context": {
    "indicium": "https://w3id.org/indicium/",
    "asb": "https://asb.holobiomics.org/ns/asb#",
    "sepio": "http://purl.obolibrary.org/obo/SEPIO_",
    "eco": "http://purl.obolibrary.org/obo/ECO_",
    "iao": "http://purl.obolibrary.org/obo/IAO_",
    "cito": "http://purl.org/spar/cito/",
    "doco": "http://purl.org/spar/doco/",
    "fabio": "http://purl.org/spar/fabio/",
    "dct": "http://purl.org/dc/terms/",
    "prov": "http://www.w3.org/ns/prov#",
    "dcat": "http://www.w3.org/ns/dcat#",
    "oa": "http://www.w3.org/ns/oa#",
    "edam": "http://edamontology.org/",

    "Claim": "asb:Claim",
    "Evidence": "sepio:0000002",
    "Source": "fabio:Expression",
    "Figure": "doco:Figure",
    "Script": "fabio:ComputerProgram",
    "DataAsset": "dcat:Dataset",
    "SoftwareEntity": "fabio:ComputerProgram",
    "IndiciumDocument": "indicium:IndiciumDocument",

    "id": "@id",
    "context": "asb:context",
    "subject": "asb:subject",
    "object": "asb:object",
    "qualifier": "asb:qualifier",
    "super_pattern": "asb:qualifier",
    "relation": "asb:relation",
    "predicate": "asb:relation",
    "claim_type": "asb:claim_type",
    "claim_status": "asb:claim_status",
    "asserted_by": "prov:wasAttributedTo",
    "superseded_by": "asb:superseded_by",

    "evidence_type": "asb:evidence_type",
    "eco_code": "asb:eco_code",
    "source_type": "asb:source_type",
    "quote": "asb:quote",
    "quote_exact": "asb:quote",
    "quote_location": "asb:quote_location",
    "confidence": "asb:confidence",
    "of_source": "asb:of_source",
    "for_claim": "sepio:0000007",
    "supports_claim": "sepio:0000007",
    "text_selector": "oa:hasSelector",
    "fragment_selector": "oa:hasSelector",
    "decision_context": "asb:decision_context",

    "identifier": "dct:identifier",
    "doi": "dct:identifier",
    "title": "dct:title",
    "authors": "dct:creator",
    "license_id": "dct:license",
    "paragraph_id": "asb:paragraph_id",
    "xpath_pointer": "asb:xpath_pointer",

    "canonical_url": { "@id": "asb:canonical_url", "@type": "@id" },
    "version": "asb:version",
    "edam_operation": { "@id": "asb:edam_operation", "@type": "@id" },
    "edam_topics": { "@id": "asb:edam_topics", "@type": "@id", "@container": "@set" },
    "bio_tools_id": "asb:bio_tools_id",

    "asserts": { "@id": "sepio:0000130", "@type": "@id" },

    "claims": { "@id": "asb:claims", "@container": "@set" },
    "evidences": { "@id": "asb:evidences", "@container": "@set" },
    "sources": { "@id": "asb:sources", "@container": "@set" },
    "figures": { "@id": "asb:figures", "@container": "@set" },
    "scripts": { "@id": "asb:scripts", "@container": "@set" },
    "datasets": { "@id": "asb:datasets", "@container": "@set" },
    "software_entities": { "@id": "asb:software_entities", "@container": "@set" },
    "claim_links": { "@id": "asb:claim_links", "@container": "@set" },
    "citation_links": { "@id": "asb:citation_links", "@container": "@set" }
  }
}
